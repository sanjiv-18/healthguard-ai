generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  role          String    @default("USER")
  dob           String?
  gender        String?
  height        Float?
  weight        Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patientProfile      PatientProfile?
  doctorProfile       DoctorProfile?
  healthReadings      VitalReading[]
  envReadings         EnvironmentReading[]
  baseline            HealthBaseline?
  riskAssessments     RiskAssessment[]
  healthScores        HealthScore[]
  alerts              Alert[]
  notifications       Notification[]
  devices             Device[]
  emergencyContacts   EmergencyContact[]
  emergencyEvents     EmergencyEvent[]
  doctorAccessGranting DoctorAccess[] @relation("UserAccess")
  doctorAccessDoctor   DoctorAccess[] @relation("DoctorAccess")
  clinicalNotesAsDoctor ClinicalNote[] @relation("ClinicalNoteDoctor")
  clinicalNotesAsPatient ClinicalNote[] @relation("ClinicalNotePatient")
  recommendations     Recommendation[]
  systemEvents        SystemEvent[]
  accessAuditLogs     AccessAuditLog[]
}

model PatientProfile {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  bloodType String?
  allergies String?
  emergencyContactName String?
  emergencyContactPhone String?
}

model DoctorProfile {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  specialty String?
  licenseNo String?
  hospital  String?
}

model VitalReading {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  deviceId  String?
  timestamp DateTime @default(now())
  heartRate Float
  spo2      Float
  bodyTemperature Float
  hydration Float
  hrv       Float?
  sleepMinutes Int?
  steps     Int      @default(0)
  stressPercent Float?
  respiratoryRate Float?
  calories  Float?
  source    String   @default("manual")
  createdAt DateTime @default(now())

  @@index([userId, timestamp])
  @@index([deviceId])
}

model EnvironmentReading {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  timestamp DateTime @default(now())
  environmentalTemperature Float
  humidity    Float
  aqi         Float
  uvIndex     Float?
  heatIndex   Float
  windSpeed   Float?
  weatherCondition String?
  source      String   @default("simulation")
  createdAt   DateTime @default(now())

  @@index([userId, timestamp])
}

model HealthBaseline {
  id              String @id @default(uuid())
  userId          String @unique
  user            User   @relation(fields: [userId], references: [id])
  heartRateMin    Float  @default(60)
  heartRateMax    Float  @default(85)
  spo2Min         Float  @default(95)
  temperatureMin  Float  @default(36.1)
  temperatureMax  Float  @default(37.2)
  hydrationMin    Float  @default(55)
  hydrationMax    Float  @default(75)
  hrvMin          Float  @default(30)
  hrvMax          Float  @default(70)
  sleepMinMinutes Int    @default(360)
  sleepMaxMinutes Int    @default(540)
  stepsMin        Int    @default(5000)
  stepsMax        Int    @default(10000)
  calculatedAt    DateTime @default(now())
}

model HealthScore {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  timestamp       DateTime @default(now())
  score           Float
  riskLevel       String
  heartRateScore  Float    @default(0)
  spo2Score       Float    @default(0)
  temperatureScore Float   @default(0)
  hydrationScore  Float    @default(0)
  sleepScore      Float    @default(0)
  activityScore   Float    @default(0)
  stressScore     Float    @default(0)
  respiratoryScore Float   @default(0)
  environmentScore Float   @default(0)
  dataQuality     String   @default("GOOD")
  reasons         String   @default("[]")
  createdAt       DateTime @default(now())

  @@index([userId, timestamp])
}

model RiskAssessment {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  timestamp       DateTime @default(now())
  overallRisk     Float
  level           String
  heatStress      Float    @default(0)
  dehydration     Float    @default(0)
  respiratory     Float    @default(0)
  cardiacStrain   Float    @default(0)
  fatigue         Float    @default(0)
  explanation     String
  recommendations String   @default("[]")
  confidence      Float    @default(0.85)

  @@index([userId, timestamp])
}

model Alert {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  timestamp DateTime @default(now())
  level     String
  category  String
  title     String
  message   String
  status    String   @default("ACTIVE")
  factors   String   @default("[]")

  @@index([userId, timestamp])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  timestamp DateTime @default(now())
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
}

model Device {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  name          String
  type          String
  manufacturer  String?
  model         String?
  provider      String   @default("SIMULATED")
  status        String   @default("CONNECTED")
  battery       Int      @default(100)
  lastSync      DateTime @default(now())
  connectedAt   DateTime @default(now())
  disconnectedAt DateTime?
  isSimulation  Boolean  @default(false)
  metadata      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model EmergencyContact {
  id        String @id @default(uuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  name      String
  phone     String
  relation  String?
}

model EmergencyEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  timestamp DateTime @default(now())
  trigger   String
  status    String   @default("TRIGGERED")
  latitude  Float?
  longitude Float?
  notes     String?
}

model DoctorAccess {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserAccess", fields: [userId], references: [id])
  doctorId  String
  doctor    User     @relation("DoctorAccess", fields: [doctorId], references: [id])
  status    String   @default("ACTIVE")
  grantedAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scopes    AccessScope[]
}

model AccessScope {
  id             String @id @default(uuid())
  doctorAccessId String
  doctorAccess   DoctorAccess @relation(fields: [doctorAccessId], references: [id])
  permission     String
}

model AccessAuditLog {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  doctorId     String
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  action       String
  dataCategory String?
  details      String?
}

model ClinicalNote {
  id          String   @id @default(uuid())
  doctorId    String
  doctor      User     @relation("ClinicalNoteDoctor", fields: [doctorId], references: [id])
  userId      String
  user        User     @relation("ClinicalNotePatient", fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  observation String
  assessment  String
  followUp    String?
}

model Recommendation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  timestamp DateTime @default(now())
  category  String
  title     String
  message   String
  priority  String   @default("MEDIUM")
}

model SystemEvent {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  type      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  details   String?
}
